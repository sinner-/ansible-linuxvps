wireguard:
  interface_address: 10.8.0.1
  listen_port: 5000
  public_key: null
  peers:
    - public_key: xxx
      allowed_ip: 10.8.0.2
ssh:
  root_authorized_keys:
    - xxx
websites:
  - domain: example.com
    letsencrypt_email: foo@bar.com
    vpn_site: False
    reverse_proxies:
      - path: /splitsies
        upstream: http://127.0.0.1:9000
  - domain: private_site.cloud
    vpn_site: True
splitsies:
  public_url: https://example.com/splitsies/
  rp_id: example.com
