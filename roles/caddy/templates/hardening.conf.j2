[Service]
Type=exec
UMask=0077
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitCORE=0
LimitNOFILE=8192
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateIPC=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/var/lib/caddy
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SocketBindAllow=tcp:80
SocketBindAllow=tcp:443
SocketBindDeny=any
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@aio @ipc @keyring @memlock @mount @obsolete @privileged @resources
SystemCallFilter=~fgetxattr flistxattr fremovexattr fsetxattr getxattr getxattrat kcmp
SystemCallFilter=~landlock_add_rule landlock_create_ruleset landlock_restrict_self
SystemCallFilter=~lgetxattr listmount listxattr listxattrat llistxattr lremovexattr lsetxattr
SystemCallFilter=~lsm_get_self_attr lsm_list_modules mknod mknodat name_to_handle_at open_tree
SystemCallFilter=~pidfd_open pidfd_send_signal removexattr removexattrat setns setxattr setxattrat
SystemCallFilter=~socketpair splice statmount swapcontext tee unshare uretprobe userfaultfd vmsplice
SystemCallFilter=pipe pipe2
