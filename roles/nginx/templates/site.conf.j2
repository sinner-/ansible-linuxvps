{% set allowed_methods = item.allowed_methods | default(nginx_default_allowed_methods) -%}
server {
    server_name {{ item.domain }};
    root /var/www/{{ item.domain }};
    index index.html index.htm;
    charset utf-8;
{% if item.client_max_body_size is defined %}
    client_max_body_size {{ item.client_max_body_size }};
{% endif %}
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

{% if item.vpn_site %}
    listen {{ wireguard.interface_address }}:80;

{% for peer in wireguard.peers %}
    allow {{ peer.allowed_ip }}/32;
{% endfor %}
    deny all;
{% else %}
    listen 443 ssl;
    ssl_certificate /etc/nginx/ssl/{{ item.domain }}.pem;
    ssl_certificate_key /etc/nginx/ssl/{{ item.domain }}.key;
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}

{% if item.reverse_proxies | default([]) -%}
{% for reverse_proxy in item.reverse_proxies %}
    location = {{ reverse_proxy.path }} {
        limit_except {{ allowed_methods | join(' ') }} {
            deny all;
        }
        return 308 {{ reverse_proxy.path }}/;
    }

    location {{ reverse_proxy.path }}/ {
        limit_except {{ allowed_methods | join(' ') }} {
            deny all;
        }
        proxy_pass {{ reverse_proxy.upstream }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix {{ reverse_proxy.path }};
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
    }
{% endfor %}

{% endif %}    location / {
        limit_except {{ allowed_methods | join(' ') }} {
            deny all;
        }
        try_files $uri $uri/ =404;
    }
}
