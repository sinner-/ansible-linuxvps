[Service]
UMask=0027
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL CAP_NET_BIND_SERVICE CAP_SETGID CAP_SETUID
AmbientCapabilities=
LimitCORE=0
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateIPC=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/run /var/lib/nginx /var/log/nginx
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SocketBindAllow=tcp:80
SocketBindAllow=tcp:443
SocketBindDeny=any
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@aio @ipc @keyring @memlock @mount @obsolete @privileged @resources fgetxattr flistxattr fremovexattr fsetxattr getxattr getxattrat kcmp landlock_add_rule landlock_create_ruleset landlock_restrict_self lgetxattr listmount listxattr listxattrat llistxattr lremovexattr lsetxattr lsm_get_self_attr lsm_list_modules mknod mknodat name_to_handle_at open_tree pidfd_open pidfd_send_signal removexattr removexattrat setns setxattr setxattrat splice statmount swapcontext tee unshare uretprobe userfaultfd vmsplice
SystemCallFilter=@chown @setuid capset io_destroy io_setup pipe pipe2
